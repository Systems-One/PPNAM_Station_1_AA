<?xml version="1.0" encoding="utf-8"?>
<!-- Panel behind a refused or failed tag send ("Tag unknown.", no response). Suite consistency C3:
     a refusal is a tinted red panel with a 1dp danger border, as on Station 3's scan status, not
     a bare red line. Text on it stays text_primary: danger on light_red is only 3.99:1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/light_red" />
    <stroke android:width="1dp" android:color="@color/danger" />
    <corners android:radius="12dp" />
</shape>
