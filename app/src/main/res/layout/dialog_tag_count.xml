<?xml version="1.0" encoding="utf-8"?>
<!--
  §6.4: closing a receipt Short or Over also declares how many tags it differs by. The
  prompt is deliberately a second step rather than a field on the close sheet, so the
  operator has already committed to the classification before being asked for a number.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTagCount"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_tag_count"
        app:boxStrokeColor="@color/outline_dark"
        app:hintTextColor="@color/text_secondary_dark">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTagCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="4"
            android:maxLines="1"
            android:textColor="@color/text_primary_dark" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvTagCountError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Enter a whole number of tags, 1 or more"
        tools:visibility="visible" />
</LinearLayout>
